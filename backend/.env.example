# Copy this file to .env and fill in your real values.
# Never commit the actual .env file to Git — it's already in .gitignore.

# ─────────────────────────────────────────────
# MySQL / Database Connection
# ─────────────────────────────────────────────
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=labline_db

# Production example (managed MySQL on Railway / PlanetScale / RDS):
# DB_HOST=your-db-host.railway.app
# DB_PORT=3306

# ─────────────────────────────────────────────
# JWT Authentication
# Generate a strong secret — e.g.:
#   python -c "import secrets; print(secrets.token_hex(48))"
# ─────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_long_random_string_minimum_48_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─────────────────────────────────────────────
# CORS & Frontend
# FRONTEND_BASE_URL  — the origin of your deployed frontend.
# ALLOWED_ORIGINS    — optional CSV of extra allowed CORS origins.
#   Leave blank for local dev (localhost defaults apply automatically).
#   For production set both to your actual deployed URL.
# ─────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5500
# Production example:
# FRONTEND_BASE_URL=https://labline.yourdomain.com
# ALLOWED_ORIGINS=https://labline.yourdomain.com,https://www.labline.yourdomain.com

# ─────────────────────────────────────────────
# Runtime Environment
# Set to "production" on the server to disable auto-reload and debug info.
# ─────────────────────────────────────────────
ENVIRONMENT=development
# Production: ENVIRONMENT=production
