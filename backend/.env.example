# Copy this file to .env and fill in your real values.
# Never commit the actual .env file to Git — it's already in .gitignore.

# MySQL connection
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=labline_db

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
FRONTEND_BASE_URL=http://localhost:5500
