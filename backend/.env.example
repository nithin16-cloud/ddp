# LabLine Environment Configuration Template
# Copy this file to .env and fill in your real values.
# Never commit the actual .env file to Git — it is ignored by .gitignore.

# Multi-database support: MySQL, PostgreSQL (Supabase/Neon/Railway), or SQLite
# MySQL (Default):
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/labline_db
# PostgreSQL (Railway, Render, Supabase):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# SQLite (Zero-config local fallback):
# DATABASE_URL=sqlite:///./labline.db

DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=labline_db

# ─────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string_minimum_48_chars
JWT_SECRET_KEY=change_this_to_a_long_random_string_minimum_48_chars
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_EXPIRE_MINUTES=1440

# ─────────────────────────────────────────────
# Development User Seeding (Optional)
# Seed users are disabled by default (SEED_USERS=false).
# To seed initial accounts, set SEED_USERS=true and provide emails and passwords below.
# ─────────────────────────────────────────────
SEED_USERS=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TECHNICIAN_EMAIL=
SEED_TECHNICIAN_PASSWORD=
SEED_PATIENT_EMAIL=
SEED_PATIENT_PASSWORD=

# ─────────────────────────────────────────────
# CORS & Frontend
# ─────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
# Optional custom directory to serve frontend statically directly at /:
# FRONTEND_DIR=../frontend

# ─────────────────────────────────────────────
# Runtime Environment
# Set to "production" on the live server.
# ─────────────────────────────────────────────
ENVIRONMENT=development
